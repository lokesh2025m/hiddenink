# Copy to .env (never commit .env). Only the backend ever sees these values.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_VISION_MODEL=gpt-5.4
OPENAI_EMBED_MODEL=text-embedding-3-small
# "low" for GPT-5-family reasoning models; leave empty if you switch to a non-reasoning model like gpt-4.1
OPENAI_REASONING_EFFORT=low
# Cheaper model for the hidden-text classifier and the Red-Team payload writer (the screeners keep OPENAI_TEXT_MODEL)
OPENAI_CHEAP_MODEL=gpt-5.4-nano

# Reasoning effort per task (reasoning models only). If the API rejects "minimal", "low" is used instead.
REASONING_VISION=minimal
REASONING_CLASSIFY=minimal
REASONING_SCREEN=low
REASONING_PAYLOAD=minimal

# Output token caps per task. A response cut off at the cap is retried once with double the cap.
MAX_TOKENS_VISION=4000
MAX_TOKENS_CLASSIFY=2000
MAX_TOKENS_SCREEN=2500
MAX_TOKENS_PAYLOAD=1500

# Days to keep reusable model answers (classifier results, Red-Team baselines) in the llm_cache collection
LLM_CACHE_DAYS=30

# Leave empty to use an in-memory database (local demo). Use a MongoDB Atlas URI in production.
MONGODB_URI=
MONGODB_DB=hiddenink

# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_HOURS=12

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

MAX_FILE_MB=10
MAX_PAGES=5
RETENTION_DAYS=30
RATE_LIMIT_SCAN=10/minute
RATE_LIMIT_REDTEAM=5/minute
FUZZ_MAX_ATTACKS=30
FUZZ_TOKEN_BUDGET=200000
ENABLE_DEMO_ACCOUNT=true
# Free trial (demo) limits. Per trial session: AI-backed scans (later scans run deterministic checks only)
# and Red-Team attacks (then 429). Sample resumes don't count.
DEMO_AI_SCANS=10
DEMO_REDTEAM_ATTACKS=5
# OpenAI calls per UTC day across all trials; past it, trial scans run deterministic checks only
DEMO_DAILY_AI_CALLS=200
# A trial ends, and its data is deleted, after this many hours without activity
DEMO_IDLE_HOURS=2
# New trials per IP address
RATE_LIMIT_DEMO=5/hour

# OpenAI spend tracker: prints a [spend] line after every API call and warns past 80% of the limit.
# Reset after topping up with: python -m app.spend reset
SPEND_LIMIT_USD=1.00
# At this share of the limit (percent), OpenAI calls stop and scans fall back to the deterministic layers
SPEND_HARD_STOP_PCT=95
# Prices in USD per 1M tokens; replaces the built-in table. Unknown models are estimated at gpt-5-mini prices.
# PRICES_JSON={"gpt-5-mini": {"in": 0.25, "out": 2.00}, "gpt-5.4-nano": {"in": 0.05, "out": 0.40}, "gpt-4o-mini": {"in": 0.15, "out": 0.60}, "text-embedding-3-small": {"in": 0.02, "out": 0}}
